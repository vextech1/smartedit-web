+import 'fake-indexeddb/auto';
+import { describe, it, expect, vi, beforeEach } from 'vitest';
+vi.mock('$app/navigation', () => ({ goto: vi.fn(async () => {}) }));
+import { StudioState, sendToTool } from '../src/lib/workspace.svelte';
+import { activeWork } from '../src/lib/active.svelte';
+import { getActiveId, setActiveId, ACTIVE_KEY } from '../src/lib/core/active';
+import { getSessions } from '../src/lib/core/session';
+import { getLibrary } from '../src/lib/core/library';
+import { toolSupports, workspaceById, workspaceSupports, workspaces } from '../src/lib/core/workspaces';
+
+const pdf = (s: string, name = 'r.pdf') => new File([s], name, { type: 'application/pdf' });
+const png = (s: string, name = 'a.png') => new File([s], name, { type: 'image/png' });
+const fakeStore = () => { const m = new Map<string, string>(); return { getItem: (k: string) => m.get(k) ?? null, setItem: (k: string, v: string) => void m.set(k, v), removeItem: (k: string) => void m.delete(k), m }; };
+
+beforeEach(async () => { await getSessions().clearAll(); await getLibrary().clearAll(); activeWork.clear(); });
+
+describe('which tools suit which file', () => {
+  it('greys out tools that need the other kind of file, and lets everything through when nothing is open', () => {
+    expect(toolSupports('compress-pdf', 'pdf')).toBe(true);
+    expect(toolSupports('edit-image', 'pdf')).toBe(false);
+    expect(toolSupports('pdf-to-docx', 'pdf')).toBe(true);
+    expect(toolSupports('extract-text', 'pdf')).toBe(false);
+    expect(toolSupports('images-to-pdf', 'image')).toBe(true);
+    expect(toolSupports('organize-pdf', 'image')).toBe(false);
+    for (const t of workspaces.flatMap((w) => w.tabs)) expect(toolSupports(t, undefined)).toBe(true);
+  });
+  it('a studio is supported when any of its tools can take the file', () => {
+    expect(workspaceSupports(workspaceById('pdf')!, 'pdf')).toBe(true);
+    expect(workspaceSupports(workspaceById('pdf')!, 'image')).toBe(false);
+    expect(workspaceSupports(workspaceById('photo')!, 'pdf')).toBe(false);
+    expect(workspaceSupports(workspaceById('convert')!, 'pdf') && workspaceSupports(workspaceById('convert')!, 'image')).toBe(true);
+    expect(workspaceSupports(workspaceById('docs')!, 'pdf') && workspaceSupports(workspaceById('docs')!, 'image')).toBe(true);
+  });
+});
+
+describe('remembering the open work', () => {
+  it('stores only the session id, and survives broken storage', () => {
+    const s = fakeStore(); setActiveId('abc', s); expect(s.m.get(ACTIVE_KEY)).toBe('abc'); expect(getActiveId(s)).toBe('abc');
+    setActiveId(undefined, s); expect(getActiveId(s)).toBeUndefined();
+    const broken = { getItem() { throw new Error('no'); }, setItem() { throw new Error('no'); }, removeItem() { throw new Error('no'); } };
+    expect(getActiveId(broken)).toBeUndefined(); expect(() => setActiveId('x', broken)).not.toThrow();
+  });
+});
+
+describe('open work follows the person across studios', () => {
+  it('opening a file makes it the open work, with its edits saved as versions', async () => {
+    const a = new StudioState('pdf'); await a.open(pdf('A'));
+    expect(activeWork.work).toMatchObject({ id: a.session!.id, kind: 'pdf', workspace: 'pdf' });
+    await a.commit(new Blob(['B'], { type: 'application/pdf' }), 'Crop', 'r-crop.pdf');
+    expect(activeWork.work!.name).toBe('r-crop.pdf');
+  });
+  it('another studio that has a tool for it opens the same file at the same edit, and Continue moves there', async () => {
+    const a = new StudioState('pdf'); await a.open(pdf('A'));
+    await a.commit(new Blob(['B'], { type: 'application/pdf' }), 'Crop', 'r-crop.pdf');
+    const id = a.session!.id;
+    const docs = new StudioState('docs');
+    expect(await docs.load(id, (k) => workspaceSupports(workspaceById('docs')!, k))).toBe(true);
+    expect(await docs.file!.text()).toBe('B'); expect(docs.session!.versions).toHaveLength(2);
+    expect((await getSessions().get(id))!.workspace).toBe('docs');
+    // an edit made there is on the same chain, so the first studio sees it too
+    await docs.commit(new Blob(['C'], { type: 'application/pdf' }), 'Compress', 'r-compress.pdf');
+    const back = new StudioState('pdf'); await back.load(id);
+    expect(await back.file!.text()).toBe('C'); expect(back.session!.versions).toHaveLength(3);
+  });
+  it('keeps an undo: a version the person stepped back from is not what the next studio opens', async () => {
+    const a = new StudioState('pdf'); await a.open(pdf('A'));
+    await a.commit(new Blob(['B'], { type: 'application/pdf' }), 'Crop', 'r2.pdf'); await a.undo();
+    const b = new StudioState('convert'); await b.load(a.session!.id);
+    expect(await b.file!.text()).toBe('A'); expect(b.canRedo).toBe(true);
+  });
+  it('a studio with no tool for the file refuses it and leaves the open work alone', async () => {
+    const a = new StudioState('pdf'); await a.open(pdf('A'));
+    const photo = new StudioState('photo');
+    expect(await photo.load(a.session!.id, (k) => workspaceSupports(workspaceById('photo')!, k))).toBe(false);
+    expect(photo.file).toBeUndefined(); expect(activeWork.work!.id).toBe(a.session!.id);
+    expect((await getSessions().get(a.session!.id))!.workspace).toBe('pdf');
+  });
+  it('closing clears the open work but keeps the session to continue later; starting another file replaces it', async () => {
+    const a = new StudioState('pdf'); await a.open(pdf('A')); const id = a.session!.id;
+    a.close(); expect(activeWork.work).toBeUndefined(); expect(await getSessions().get(id)).toBeDefined();
+    const b = new StudioState('photo'); await b.open(png('P'));
+    expect(activeWork.work!.id).toBe(b.session!.id); expect(activeWork.work!.kind).toBe('image');
+    await a.load(id); expect(activeWork.work!.id).toBe(id);   // Continue makes it the open work again
+  });
+  it('discarding the open work forgets it everywhere', async () => {
+    const a = new StudioState('pdf'); await a.open(pdf('A')); const id = a.session!.id;
+    await a.discard(); expect(activeWork.work).toBeUndefined(); expect(await getSessions().get(id)).toBeUndefined();
+  });
+  it('sending a result to a tool in another studio makes it the open work', async () => {
+    await sendToTool(new Blob(['X'], { type: 'application/pdf' }), 'x.pdf', 'pdf-to-docx');
+    expect(activeWork.work).toMatchObject({ kind: 'pdf', workspace: 'docs' });
+  });
+  it('refresh forgets work that was deleted or expired', async () => {
+    const a = new StudioState('pdf'); await a.open(pdf('A'));
+    await getSessions().discard(a.session!.id); await activeWork.refresh();
+    expect(activeWork.work).toBeUndefined();
+  });
+});
diff --git a/tests/work-limit.test.ts b/tests/work-limit.test.ts
new file mode 100644
index 0000000..bd4e5b5
--- /dev/null
+++ b/tests/work-limit.test.ts
@@ -0,0 +1,100 @@
+import 'fake-indexeddb/auto';
+import { describe, it, expect, vi, beforeEach, afterEach } from 'vitest';
+vi.mock('$app/navigation', () => ({ goto: vi.fn(async () => {}) }));
+import { StudioState, FULL_NOTE, FULL_OPEN_NOTE } from '../src/lib/workspace.svelte';
+import { activeWork, workUsage } from '../src/lib/active.svelte';
+import { Sessions, MemorySessionStore, WorkLimitError, WORK_LIMIT_BYTES, getSessions } from '../src/lib/core/session';
+import { getLibrary } from '../src/lib/core/library';
+
+const pdf = (s: string, name = 'r.pdf') => new File([s], name, { type: 'application/pdf' });
+const blob = (s: string) => new Blob([s], { type: 'application/pdf' });
+const setLimit = (n: number) => Object.assign(getSessions(), { limit: n });
+
+describe('the 100 MB limit', () => {
+  it('is 100 MB', () => { expect(WORK_LIMIT_BYTES).toBe(100 * 1024 * 1024); });
+
+  it('counts every piece of unfinished work together and reports almost full and full', async () => {
+    const s = new Sessions(new MemorySessionStore(), undefined, undefined, undefined, 10);
+    expect(await s.usage()).toMatchObject({ used: 0, limit: 10, near: false, full: false });
+    await s.start('pdf', pdf('AAAAAAAA'), 'a.pdf');                       // 8 of 10
+    expect(await s.usage()).toMatchObject({ used: 8, near: true, full: false });
+    await s.start('photo', new Blob(['BB'], { type: 'image/png' }), 'b.png');   // 10 of 10, across studios
+    expect(await s.usage()).toMatchObject({ used: 10, near: true, full: true });
+  });
+  it('refuses new work and new versions past the limit, and changes nothing when it refuses', async () => {
+    const s = new Sessions(new MemorySessionStore(), undefined, undefined, undefined, 10);
+    const a = await s.start('pdf', pdf('AAAAAA'), 'a.pdf');
+    await expect(s.start('pdf', pdf('BBBBB'), 'b.pdf')).rejects.toBeInstanceOf(WorkLimitError);
+    await expect(s.commit(a.id, blob('CCCCC'), 'Crop')).rejects.toBeInstanceOf(WorkLimitError);
+    expect((await s.get(a.id))!.versions).toHaveLength(1); expect(await s.totalBytes()).toBe(6); expect(await s.list()).toHaveLength(1);
+    expect((await s.commit(a.id, blob('CC'), 'Crop'))!.added).toBe(true);   // fits: saves as normal
+  });
+  it('an identical result is not an error even when full', async () => {
+    const s = new Sessions(new MemorySessionStore(), undefined, undefined, undefined, 6);
+    const a = await s.start('pdf', pdf('AAAAAA'), 'a.pdf');
+    expect((await s.commit(a.id, blob('AAAAAA'), 'Same'))!.added).toBe(false);
+  });
+  it('making room (delete, or keep only original and latest) lets saving resume', async () => {
+    const s = new Sessions(new MemorySessionStore(), undefined, undefined, undefined, 12);
+    const a = await s.start('pdf', pdf('AA'), 'a.pdf');
+    await s.commit(a.id, blob('BBBB'), 'One'); await s.commit(a.id, blob('CCCC'), 'Two');   // 10 of 12, three versions
+    await expect(s.commit(a.id, blob('DDDDDD'), 'Three')).rejects.toBeInstanceOf(WorkLimitError);
+    expect(await s.compactAll()).toBe(4);                                                    // drops the middle version
+    expect((await s.commit(a.id, blob('DDDDDD'), 'Three'))!.added).toBe(true);
+    await expect(s.start('pdf', pdf('X'), 'x.pdf')).rejects.toBeInstanceOf(WorkLimitError);   // full again
+    await s.discard(a.id);
+    expect((await s.start('pdf', pdf('X'), 'x.pdf')).versions).toHaveLength(1);                // deleting work makes room
+  });
+});
+
+describe('when unfinished work is full, other activity carries on but is not saved automatically', () => {
+  beforeEach(async () => { await getSessions().clearAll(); await getLibrary().clearAll(); activeWork.clear(); });
+  afterEach(() => { setLimit(WORK_LIMIT_BYTES); });
+
+  it('keeps an edit that does not fit in memory, warns, and still lets the person undo it', async () => {
+    setLimit(10);
+    const st = new StudioState('pdf'); await st.open(pdf('AAAA'));
+    expect(st.memoryOnly).toBe(false);
+    const h0 = st.head;
+    expect(await st.commit(blob('BBBBBBB'), 'Crop', 'r-crop.pdf')).toBe(true);
+    expect(st.unsaved).toBe(true); expect(st.note).toBe(FULL_NOTE);
+    expect(await st.file!.text()).toBe('BBBBBBB'); expect(st.head).not.toBe(h0);
+    expect(st.session!.versions).toHaveLength(1);                 // nothing was written
+    expect(st.canUndo).toBe(true); expect(st.canRedo).toBe(false);
+    await st.undo();
+    expect(st.unsaved).toBe(false); expect(await st.file!.text()).toBe('AAAA'); expect(st.note).toBe(''); expect(st.head).toBe(h0);
+  });
+  it('the unsaved change follows the person into another studio, and a closing warning protects it', async () => {
+    setLimit(10);
+    const a = new StudioState('pdf'); await a.open(pdf('AAAA'));
+    await a.commit(blob('BBBBBBB'), 'Crop', 'r-crop.pdf');
+    const b = new StudioState('docs'); expect(await b.load(a.session!.id)).toBe(true);
+    expect(b.unsaved).toBe(true); expect(await b.file!.text()).toBe('BBBBBBB');
+    const ask = vi.fn(() => false); vi.stubGlobal('confirm', ask);
+    expect(activeWork.release()).toBe(false); expect(ask).toHaveBeenCalled(); expect(activeWork.work).toBeDefined();   // stayed
+    ask.mockReturnValue(true); expect(activeWork.release()).toBe(true); expect(activeWork.work).toBeUndefined();     // chose to leave
+    vi.unstubAllGlobals();
+  });
+  it('saves again, with the unsaved change as a new version, once there is room', async () => {
+    setLimit(10);
+    const st = new StudioState('pdf'); await st.open(pdf('AAAA'));
+    await st.commit(blob('BBBBBBB'), 'Crop', 'r-crop.pdf'); expect(st.unsaved).toBe(true);
+    setLimit(100);                                                  // the person made room
+    expect(await st.commit(blob('CCCCCCC'), 'Stamp', 'r-stamp.pdf')).toBe(true);
+    expect(st.unsaved).toBe(false); expect(st.note).toBe(''); expect(st.session!.versions).toHaveLength(2);
+    expect(activeWork.unsaved).toBeUndefined(); expect(await st.file!.text()).toBe('CCCCCCC');
+  });
+  it('a new file that does not fit is used from memory, with a warning, and does not replace the open work', async () => {
+    setLimit(10);
+    const first = new StudioState('pdf'); await first.open(pdf('AAAAAAAA')); const openId = activeWork.work!.id;
+    const next = new StudioState('pdf'); await next.open(pdf('BBBBBBBB', 'b.pdf'));
+    expect(next.memoryOnly).toBe(true); expect(next.session).toBeUndefined(); expect(next.note).toBe(FULL_OPEN_NOTE);
+    expect(await next.file!.text()).toBe('BBBBBBBB'); expect(activeWork.work!.id).toBe(openId);
+    expect(await getSessions().list()).toHaveLength(1);
+  });
+  it('shows usage to the pages', async () => {
+    setLimit(10);
+    const st = new StudioState('pdf'); await st.open(pdf('AAAAAAAAA')); await workUsage.refresh();
+    expect(workUsage.used).toBe(9); expect(workUsage.near).toBe(true); expect(workUsage.full).toBe(false); expect(workUsage.percent).toBe(90);
+  });
+});
